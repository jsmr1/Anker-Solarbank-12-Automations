- id: solarbank_2_pro_vereinfacht
  alias: 'Solarbank 2 Pro: Vereinfachte Null-Einspeisung'
  description: Regelt die SB2 Pro dynamisch im 60-Sekunden-Takt basierend auf dem
    Hausverbrauch.
  mode: restart
  trigger:
  - platform: time_pattern
    minutes: /1
  action:
  - choose:
    - conditions:
      - condition: template
        value_template: '{{ states(''sensor.sb_2_e1600_pro_ladestand'') | float(0)
          <= 8 }}'
      - condition: template
        value_template: '{{ states(''sensor.sb_2_e1600_pro_einspeisevorgabe'') | float(999)
          > 0 }}'
      sequence:
      - service: number.set_value
        target:
          entity_id: number.sb_2_e1600_pro_system_einspeisevorgabe
        data:
          value: 0
    - conditions:
      - condition: template
        value_template: '{{ states(''sensor.sb_2_e1600_pro_ladestand'') | float(0)
          > 8 }}'
      - condition: template
        value_template: '{% set aktuelle_vorgabe = states(''sensor.sb_2_e1600_pro_einspeisevorgabe'')
          | float(0) %} {% set shelly = states(''sensor.wohnzimmer_akku_shelly_leistung'')
          | float(0) * -1 %} {% set netz = states(''sensor.online_gemessener_verbrauch_sw'')
          | float(0) %} {% set ziel = shelly + netz %} {{ (ziel - aktuelle_vorgabe)
          | abs > 15 }}
          '
      sequence:
      - service: number.set_value
        target:
          entity_id: number.sb_2_e1600_pro_system_einspeisevorgabe
        data:
          value: "{% set aktuelle_vorgabe = states('sensor.sb_2_e1600_pro_einspeisevorgabe')
            | float(0) %} {% set shelly = states('sensor.wohnzimmer_akku_shelly_leistung')
            | float(0) * -1 %} {% set netz = states('sensor.online_gemessener_verbrauch_sw')
            | float(0) %} {% set ziel = shelly + netz %}\n{# Maximale Schrittweite
            pro Minute #} {% set max_change = 200 %}\n{# Berechnung der Schrittweiten-Dämpfung
            #} {% set diff = ziel - aktuelle_vorgabe %} {% if diff > max_change %}\n
            \ {% set neue_vorgabe = aktuelle_vorgabe + max_change %}\n{% elif diff
            < (-1 * max_change) %}\n  {% set neue_vorgabe = aktuelle_vorgabe - max_change
            %}\n{% else %}\n  {% set neue_vorgabe = ziel %}\n{% endif %}\n{# Begrenzung
            der Solarbank auf 0 bis 800W #} {% if neue_vorgabe > 800 %}\n  800\n{%
            elif neue_vorgabe < 0 %}\n  0\n{% else %}\n  {{ neue_vorgabe | int }}\n{%
            endif %}\n"

        | float(0)\n  ) | round(2)\n}}\n"
  mode: single
(END)

